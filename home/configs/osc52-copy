#!/bin/bash
# OSC52 clipboard copy script for SSH/mosh sessions
# Works by sending escape sequences through the terminal

copy_via_osc52() {
    local input
    if [ -t 0 ]; then
        input="$*"
    else
        input=$(cat)
    fi
    
    # Encode input as base64
    local encoded=$(printf '%s' "$input" | base64 -w0)
    
    # Send OSC52 sequence
    # Format: \033]52;c;<base64_data>\007
    printf '\033]52;c;%s\007' "$encoded"
}

copy_via_osc52 "$@"